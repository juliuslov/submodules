{
  "name": "wizardo-submodule-services",
  "version": "1.0.0",
  "description": "C Rust Lua TypeScript EPUB MOBI ASCII and KoSync companion services for installer.nvim",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build:types": "tsc -p scripts/tsconfig.vendor.json",
    "build": "make native ascii mobi && npm run build:types && node scripts/build.mjs",
    "typecheck": "npm run build:types && tsc --noEmit",
    "test": "npm run build && npm run typecheck && make test-native test-ascii test-mobi && node --test tests/*.test.cjs",
    "doctor": "node dist/cli.cjs doctor",
    "build:ascii": "make ascii",
    "build:mobi": "make mobi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliuslov/submodules.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/juliuslov/submodules/issues"
  },
  "homepage": "https://github.com/juliuslov/submodules#readme",
  "dependencies": {
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
